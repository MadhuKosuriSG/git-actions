      <guid isPermaLink="false">research-005</guid>
      <media:content
        url="https://papers.example.org/videos/research.mp4"/>
    </item>

    <!-- Test 6: Atom enclosure link extension -->
    <item>
      <title>Atom Enclosure Image</title>
