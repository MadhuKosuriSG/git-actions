      <guid isPermaLink="false">research-002</guid>
      <media:content
        url="https://papers.example.org/media/diagram"
        type="image/png"
        medium="image"/>
    </item>

    <!-- Test 3: Video through Media RSS medium -->
    <item>
      <title>Research Presentation</title>
      <link>https://papers.example.org/presentation</link>
